# Optional — the app works fully offline in guest mode without these.
# Copy to .env.local and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only for `npm run data:supabase` (seeding reference tables). NEVER expose this to the browser
# and never prefix it with VITE_.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
